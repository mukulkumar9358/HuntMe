# Copy to .env and fill in real values. Never commit .env.

APP_ENV=development            # development | test | staging | production
APP_DEBUG=false
FRONTEND_URL=http://localhost:3000   # must be https:// in staging/production
BACKEND_URL=http://localhost:8000

# Postgres (used by docker-compose and to build DATABASE_URL)
POSTGRES_USER=huntme
POSTGRES_PASSWORD=
POSTGRES_DB=huntme

# Outside Docker, set these directly instead:
DATABASE_URL=postgresql+asyncpg://huntme:CHANGE_ME@localhost:5432/huntme
REDIS_URL=redis://localhost:6379/0

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
COOKIE_DOMAIN=                 # optional: share cookies across subdomains (e.g. .example.com)
TRUST_PROXY_HEADERS=false      # true when running behind the Next.js proxy / a load balancer
TRUSTED_PROXY_HOPS=1

AUTH_RATE_LIMIT_ATTEMPTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# Used from later stages
MAP_PROVIDER=maplibre
MAP_API_KEY=

AWS_REGION=
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

LOCATION_TTL_SECONDS=30
LOCATION_UPDATE_INTERVAL_SECONDS=5
RADAR_REFRESH_INTERVAL_SECONDS=15

DEFAULT_HIDE_DURATION_SECONDS=120
DEFAULT_HUNT_DURATION_SECONDS=600
DEFAULT_QR_EXPIRY_SECONDS=60

PHOTO_MAX_SIZE_MB=10
PHOTO_RETENTION_DAYS=30

# Frontend (both are baked in at build time)
BACKEND_INTERNAL_URL=http://localhost:8000
# Address the BROWSER uses for WebSockets (the API directly): ws://localhost:8000 locally, wss://api.example.com in production
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# Rooms
ROOM_CREATE_RATE_LIMIT_ATTEMPTS=10
ROOM_JOIN_RATE_LIMIT_ATTEMPTS=10
ROOM_RATE_LIMIT_WINDOW_SECONDS=60
INVITE_TOKEN_TTL_HOURS=24
PRESENCE_TTL_SECONDS=40
